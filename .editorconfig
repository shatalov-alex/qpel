root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,qpel,cu,cuh,metal,h,cpp,sh}]
indent_style = space
indent_size = 4

[*.qpel]
indent_size = 2

[*.{md,yml,yaml,json,cff}]
indent_style = space
indent_size = 2

[*.patch]
trim_trailing_whitespace = false
end_of_line = unset

[{portable/corpus/**,languages/**,.mps/**}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
