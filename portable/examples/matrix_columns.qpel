// Column-major matrix memory (IR version 15): C = A B with A row-major (M x K), B column-major (element
// (k, j) at b[j K + k], as BLAS and NVIDIA's WMMA samples keep it) and C written column-major (element
// (r, j) at c[j M + r]). Each subgroup computes one 8x8 tile. The shape is n = (N, M, K), each a multiple
// of 8; columns_f16 multiplies f16 matrices and accumulates in f32.
module matrix_columns {
  kernel columns_f32(a: buffer<f32, read> @0, b: buffer<f32, read> @1, c: buffer<f32, write> @2, n: shape3 @3) groups {
    let tile: u32 = (qpel.group.x * 2u) + qpel.subgroup_index;
    let across: u32 = n.x / 8u;
    if (tile < (across * (n.y / 8u))) {
      let row: u32 = (tile / across) * 8u;
      let column: u32 = (tile % across) * 8u;
      let sum: matrix<f32, 8, 8> = qpel.matrix_fill<f32>(0.0f);
      for (let k: u32 = 0u; k < n.z; k = k + 8u) {
        let left: matrix<f32, 8, 8> = qpel.matrix_load(a, (row * n.z) + k, n.z);
        let right: matrix<f32, 8, 8> = qpel.matrix_load_columns(b, (column * n.z) + k, n.z);
        sum = qpel.matrix_mma(left, right, sum);
      }
      qpel.matrix_store_columns(sum, c, (column * n.y) + row, n.y);
    }
  }
  kernel columns_f16(a: buffer<f16, read> @0, b: buffer<f16, read> @1, c: buffer<f32, write> @2, n: shape3 @3) groups {
    let tile: u32 = (qpel.group.x * 2u) + qpel.subgroup_index;
    let across: u32 = n.x / 8u;
    if (tile < (across * (n.y / 8u))) {
      let row: u32 = (tile / across) * 8u;
      let column: u32 = (tile % across) * 8u;
      let sum: matrix<f32, 8, 8> = qpel.matrix_fill<f32>(0.0f);
      for (let k: u32 = 0u; k < n.z; k = k + 8u) {
        let left: matrix<f16, 8, 8> = qpel.matrix_load(a, (row * n.z) + k, n.z);
        let right: matrix<f16, 8, 8> = qpel.matrix_load_columns(b, (column * n.z) + k, n.z);
        sum = qpel.matrix_mma(left, right, sum);
      }
      qpel.matrix_store_columns(sum, c, (column * n.y) + row, n.y);
    }
  }
}
pipeline matrix_columns_launch {
  shape n;
  input a: buffer<f32, read> in n;
  input b: buffer<f32, read> in n;
  input a16: buffer<f16, read> in n;
  input b16: buffer<f16, read> in n;
  output c: buffer<f32, write> in n;
  output c16: buffer<f32, write> in n;
  dispatch columns_f32 over n block (64, 1, 1) groups ("(W*H/64 + 1)/2", "1", "1") (a = a, b = b, c = c, n = n);
  dispatch columns_f16 over n block (64, 1, 1) groups ("(W*H/64 + 1)/2", "1", "1") (a = a16, b = b16, c = c16, n = n);
}
