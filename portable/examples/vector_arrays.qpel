// Arrays of vectors (IR version 11), as CUB-style code keeps several items of a pair type per
// thread: each thread loads four (a, b) pairs, composes them in order as mamba's selective scan
// does (x -> a x + b, so (a0, b0) then (a1, b1) is (a1 a0, a1 b0 + b1)), and writes each prefix.
module vector_arrays {
  fn load(x: buffer<f32, read>, base: u32, ref items: array<vec<f32, 2>, 4>) -> void {
    for (let k: u32 = 0u; k < 4u; k = k + 1u) {
      items[k] = vec<f32, 2>(x[(base + k) * 2u], x[((base + k) * 2u) + 1u]);
    }
  }
  fn compose(first: vec<f32, 2>, second: vec<f32, 2>) -> vec<f32, 2> {
    return vec<f32, 2>(second.x * first.x, (second.x * first.y) + second.y);
  }
  fn prefixes(ref items: array<vec<f32, 2>, 4>) -> void {
    for (let k: u32 = 1u; k < 4u; k = k + 1u) {
      items[k] = compose(items[k - 1u], items[k]);
    }
  }
  kernel vector_arrays(x: buffer<f32, read> @0, y: buffer<f32, write> @1, n: shape3 @2) grid1d {
    if (qpel.index >= ((n.x * n.y) * n.z)) {
      return;
    }
    let items: array<vec<f32, 2>, 4> = [vec<f32, 2>(1.0f, 0.0f), vec<f32, 2>(1.0f, 0.0f), vec<f32, 2>(1.0f, 0.0f), vec<f32, 2>(1.0f, 0.0f)];
    load(x, qpel.index * 4u, items);
    prefixes(items);
    for (let k: u32 = 0u; k < 4u; k = k + 1u) {
      y[((qpel.index * 4u) + k) * 2u] = items[k].x;
      y[(((qpel.index * 4u) + k) * 2u) + 1u] = items[k].y;
    }
  }
}
pipeline vector_arrays_launch {
  input x: buffer<f32, read> in n * 8;
  output y: buffer<f32, write> in n * 8;
  shape n;
  dispatch vector_arrays over n block (64) (x = x, y = y, n = n);
}
